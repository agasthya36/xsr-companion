<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Slight overall tint so the photo sits in the dark theme. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24000000" />
        </shape>
    </item>

    <!-- Dark at the top for the model name. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00080B11"
                android:startColor="#B3080B11" />
        </shape>
    </item>

    <!-- Dark at the bottom for the connection row. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00080B11"
                android:startColor="#E6080B11" />
        </shape>
    </item>
</layer-list>
