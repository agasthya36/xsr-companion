# Built application files
*.apk
*.aar
*.ap_
*.aab

# Never commit prebuilt APKs (use GitHub Releases instead)
release/*.apk

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
app/build/
build/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Machine-specific Gradle settings (e.g. org.gradle.java.home)
gradle.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/libraries
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# OS specific files
.DS_Store
Thumbs.db
